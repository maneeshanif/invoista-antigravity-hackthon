# Clerk Authentication Keys
# IMPORTANT: EXPO_PUBLIC_ prefix is required for keys used in the frontend code.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_publishable_key_here

# WARNING: Secret keys should generally be kept in the backend, not the frontend bundle.
CLERK_SECRET_KEY=your_secret_key_here

# Vapi Voice Assistant Keys
EXPO_PUBLIC_VAPI_API_KEY=your_vapi_public_api_key
EXPO_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id
